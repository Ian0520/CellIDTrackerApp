+package com.example.locationdata
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.Card
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.OutlinedButton
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import org.json.JSONObject
+
+private const val MAX_INDOOR_LABEL_LENGTH = 80
+
+data class IndoorLabel(
+    val building: String = "",
+    val floor: String = "",
+    val point: String = "",
+    val route: String = ""
+)
+
+fun IndoorLabel.toJson(): JSONObject = JSONObject()
+    .put("building", building.take(MAX_INDOOR_LABEL_LENGTH))
+    .put("floor", floor.take(MAX_INDOOR_LABEL_LENGTH))
+    .put("point", point.take(MAX_INDOOR_LABEL_LENGTH))
+    .put("route", route.take(MAX_INDOOR_LABEL_LENGTH))
+
+fun JSONObject.toIndoorLabel(): IndoorLabel = IndoorLabel(
+    building = indoorLabelValue("building"),
+    floor = indoorLabelValue("floor"),
+    point = indoorLabelValue("point"),
+    route = indoorLabelValue("route")
+)
+
+private fun JSONObject.indoorLabelValue(name: String): String =
+    if (!has(name) || isNull(name)) "" else optString(name, "").take(MAX_INDOOR_LABEL_LENGTH)
+
+@Composable
+fun IndoorMarkerPanel(
+    label: IndoorLabel,
+    onLabelChange: (IndoorLabel) -> Unit,
+    onMark: (String) -> Unit,
+    enabled: Boolean,
+    labelsEditable: Boolean = true
+) {
+    Card(modifier = Modifier.fillMaxWidth()) {
+        Column(
+            modifier = Modifier.padding(12.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            Text("Indoor checkpoints", style = MaterialTheme.typography.titleMedium)
+            Text(
+                "Optional labels entered by you. Floors are not detected automatically.",
+                style = MaterialTheme.typography.bodySmall
+            )
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(
+                    value = label.building,
+                    onValueChange = { onLabelChange(label.copy(building = it.take(MAX_INDOOR_LABEL_LENGTH))) },
+                    label = { Text("Building") },
+                    singleLine = true,
+                    enabled = labelsEditable,
+                    modifier = Modifier.weight(1f)
+                )
+                OutlinedTextField(
+                    value = label.floor,
+                    onValueChange = { onLabelChange(label.copy(floor = it.take(MAX_INDOOR_LABEL_LENGTH))) },
+                    label = { Text("Floor") },
+                    singleLine = true,
+                    enabled = labelsEditable,
+                    modifier = Modifier.weight(1f)
+                )
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedTextField(
+                    value = label.point,
+                    onValueChange = { onLabelChange(label.copy(point = it.take(MAX_INDOOR_LABEL_LENGTH))) },
+                    label = { Text("Point") },
+                    singleLine = true,
+                    enabled = labelsEditable,
+                    modifier = Modifier.weight(1f)
+                )
+                OutlinedTextField(
+                    value = label.route,
+                    onValueChange = { onLabelChange(label.copy(route = it.take(MAX_INDOOR_LABEL_LENGTH))) },
+                    label = { Text("Route") },
+                    singleLine = true,
+                    enabled = labelsEditable,
+                    modifier = Modifier.weight(1f)
+                )
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(
+                    onClick = { onMark("point_arrival") },
+                    enabled = enabled,
+                    modifier = Modifier.weight(1f)
+                ) { Text("Arrived at point") }
+                OutlinedButton(
+                    onClick = { onMark("movement_start") },
+                    enabled = enabled,
+                    modifier = Modifier.weight(1f)
+                ) { Text("Start moving") }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                OutlinedButton(
+                    onClick = { onMark("floor_change_start") },
+                    enabled = enabled,
+                    modifier = Modifier.weight(1f)
+                ) { Text("Start floor change") }
+                OutlinedButton(
+                    onClick = { onMark("floor_change_end") },
+                    enabled = enabled,
+                    modifier = Modifier.weight(1f)
+                ) { Text("End floor change") }
+            }
+        }
+    }
+}
