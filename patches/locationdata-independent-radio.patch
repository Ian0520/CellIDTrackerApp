+package com.example.locationdata
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class RadioCellReadTest {
+    @Test
+    fun successfulReadPreservesCellMeasurementDetails() {
+        val cell = CellSnapshot(
+            key = "LTE:466-92:17:123456:123", rat = "LTE", registered = true,
+            connectionStatus = null, timestampMillis = 1000, ageMillis = 700,
+            mcc = 466, mnc = 92, areaCode = 17, cellId = 123456, pci = 123,
+            channelNumber = null, bands = emptyList(), bandwidthKhz = null,
+            signalLevel = null, signalAsu = null, signalDbm = -100, signalMetrics = emptyMap()
+        )
+        val result = readRadioCells(hasLocationPermission = true, telephonyAvailable = true) { listOf(cell) }
+        assertEquals("ok", result.status)
+        assertEquals(listOf(cell), result.cells)
+        assertNull(result.errorReason)
+    }
+
+    @Test
+    fun permissionDeniedSkipsRead() {
+        val result = readRadioCells(hasLocationPermission = false, telephonyAvailable = true) {
+            error("must not read without permission")
+        }
+        assertEquals("permission_denied", result.status)
+        assertEquals("location_permission_missing", result.errorReason)
+    }
+
+    @Test
+    fun unavailableTelephonySkipsRead() {
+        val result = readRadioCells(hasLocationPermission = true, telephonyAvailable = false) {
+            error("must not read without telephony")
+        }
+        assertEquals("unavailable", result.status)
+    }
+
+    @Test
+    fun successfulEmptyReadIsDistinctFromFailure() {
+        val result = readRadioCells(hasLocationPermission = true, telephonyAvailable = true) { emptyList() }
+        assertEquals("empty", result.status)
+        assertNull(result.errorReason)
+    }
+
+    @Test
+    fun revokedPermissionIsRecordedWithoutExceptionMessage() {
+        val result = readRadioCells(hasLocationPermission = true, telephonyAvailable = true) {
+            throw SecurityException("private vendor details")
+        }
+        assertEquals("permission_denied", result.status)
+        assertEquals("SecurityException", result.errorReason)
+    }
+
+    @Test
+    fun failedReadDoesNotLookLikeNoCells() {
+        val result = readRadioCells(hasLocationPermission = true, telephonyAvailable = true) {
+            throw IllegalStateException("private vendor details")
+        }
+        assertEquals("error", result.status)
+        assertEquals("IllegalStateException", result.errorReason)
+    }
+}
