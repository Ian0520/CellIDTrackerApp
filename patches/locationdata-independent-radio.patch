+
+internal data class RadioCellReadResult(
+    val cells: List<CellSnapshot>,
+    val status: String,
+    val errorReason: String? = null
+)
+
+/** Keep missing measurements distinct from denied or failed reads, without storing exception messages. */
+internal fun readRadioCells(
+    hasLocationPermission: Boolean,
+    telephonyAvailable: Boolean,
+    readCells: () -> List<CellSnapshot>
+): RadioCellReadResult {
+    if (!telephonyAvailable) return RadioCellReadResult(emptyList(), "unavailable", "telephony_unavailable")
+    if (!hasLocationPermission) return RadioCellReadResult(emptyList(), "permission_denied", "location_permission_missing")
+    return try {
+        val cells = readCells()
+        RadioCellReadResult(cells, if (cells.isEmpty()) "empty" else "ok")
+    } catch (_: SecurityException) {
+        RadioCellReadResult(emptyList(), "permission_denied", "SecurityException")
+    } catch (error: Exception) {
+        RadioCellReadResult(emptyList(), "error", error.javaClass.simpleName)
+    }
+}
 
