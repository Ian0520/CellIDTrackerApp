+package com.example.locationdata
+
+import android.telephony.CellInfo
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class ServingCellSelectionTest {
+    @Test
+    fun noRegisteredCellDoesNotFallBackToNeighbour() {
+        val selection = selectServingCell(listOf(cell("neighbour", registered = false)))
+        assertNull(selection.cell)
+        assertEquals("no_registered", selection.status)
+        assertEquals(0, selection.registeredCellCount)
+    }
+
+    @Test
+    fun uniqueRegisteredCellCanBeSelectedWithoutConnectionStatus() {
+        val serving = cell("serving")
+        val selection = selectServingCell(listOf(cell("neighbour", registered = false), serving))
+        assertEquals(serving, selection.cell)
+        assertEquals("selected_registered", selection.status)
+        assertEquals(1, selection.registeredCellCount)
+    }
+
+    @Test
+    fun uniquePrimaryWinsOverRegisteredSecondary() {
+        val primary = cell("primary", connectionStatus = CellInfo.CONNECTION_PRIMARY_SERVING)
+        val secondary = cell("secondary", connectionStatus = CellInfo.CONNECTION_SECONDARY_SERVING)
+        val selection = selectServingCell(listOf(secondary, primary))
+        assertEquals(primary, selection.cell)
+        assertEquals("selected_primary", selection.status)
+        assertEquals(2, selection.registeredCellCount)
+    }
+
+    @Test
+    fun multiplePrimaryCellsAreAmbiguous() {
+        val selection = selectServingCell(listOf(
+            cell("first", connectionStatus = CellInfo.CONNECTION_PRIMARY_SERVING),
+            cell("second", connectionStatus = CellInfo.CONNECTION_PRIMARY_SERVING)
+        ))
+        assertNull(selection.cell)
+        assertEquals("ambiguous_registered", selection.status)
+        assertEquals(2, selection.registeredCellCount)
+    }
+
+    @Test
+    fun multipleRegisteredWithoutPrimaryAreAmbiguous() {
+        val selection = selectServingCell(listOf(
+            cell("first", connectionStatus = CellInfo.CONNECTION_SECONDARY_SERVING), cell("second")
+        ))
+        assertNull(selection.cell)
+        assertEquals("ambiguous_registered", selection.status)
+    }
+
+    @Test
+    fun unregisteredPrimaryFlagCannotOverrideRegistration() {
+        val serving = cell("serving")
+        val selection = selectServingCell(listOf(
+            cell("unregistered", registered = false, connectionStatus = CellInfo.CONNECTION_PRIMARY_SERVING), serving
+        ))
+        assertEquals(serving, selection.cell)
+    }
+
+    @Test
+    fun callerCompatibleIdentityExcludesPciAndRequiresFullTuple() {
+        val first = cell("first")
+        val second = first.copy(key = "second", pci = 456)
+        assertEquals("LTE:466-92:17:123456", first.callerCompatibleKey())
+        assertEquals(first.callerCompatibleKey(), second.callerCompatibleKey())
+        assertNull(first.copy(areaCode = null).callerCompatibleKey())
+    }
+
+    private fun cell(key: String, registered: Boolean = true, connectionStatus: Int? = null) = CellSnapshot(
+        key = key,
+        rat = "LTE",
+        registered = registered,
+        connectionStatus = connectionStatus,
+        timestampMillis = 1000,
+        ageMillis = 0,
+        mcc = 466,
+        mnc = 92,
+        areaCode = 17,
+        cellId = 123456,
+        pci = 123,
+        channelNumber = null,
+        bands = emptyList(),
+        bandwidthKhz = null,
+        signalLevel = null,
+        signalAsu = null,
+        signalDbm = null,
+        signalMetrics = emptyMap()
+    )
+}
