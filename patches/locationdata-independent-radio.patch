+package com.example.locationdata
+
+import android.telephony.CellInfo
+
+data class ServingCellSelection(
+    val cell: CellSnapshot?,
+    val status: String,
+    val registeredCellCount: Int
+)
+
+/** Do not turn an unregistered neighbour or an arbitrary member of a multi-cell report into a serving cell. */
+fun selectServingCell(cells: List<CellSnapshot>): ServingCellSelection {
+    val registered = cells.filter { it.registered }
+    val primary = registered.filter { it.connectionStatus == CellInfo.CONNECTION_PRIMARY_SERVING }
+    return when {
+        primary.size == 1 -> ServingCellSelection(primary.single(), "selected_primary", registered.size)
+        registered.size == 1 -> ServingCellSelection(registered.single(), "selected_registered", 1)
+        registered.isEmpty() -> ServingCellSelection(null, "no_registered", 0)
+        else -> ServingCellSelection(null, "ambiguous_registered", registered.size)
+    }
+}
+
+/** Identity available to a single-cell caller model; PCI stays in the raw snapshot as a diagnostic. */
+fun CellSnapshot.callerCompatibleKey(): String? {
+    val fullMcc = mcc ?: return null
+    val fullMnc = mnc ?: return null
+    val fullArea = areaCode ?: return null
+    val fullCellId = cellId ?: return null
+    return "$rat:$fullMcc-$fullMnc:$fullArea:$fullCellId"
+}
