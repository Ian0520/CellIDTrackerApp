+        val first = startRecorder()
+        captureTick(first)
+        ShadowSystemClock.advanceBy(Duration.ofSeconds(1))
+        captureTick(first)
+        val sessionId = requireNotNull(first.activeSessionId)
+        first.onCaptureServiceStopped("test pause", sessionId)
+        assertFalse(first.statusText, first.isRecording)
+
+        // Wait for the actual serialized metadata write before simulating a new recorder.
+        val metadataFile = File(application.filesDir, ACTIVE_SESSION_STATE_FILE)
+        await("paused session metadata was not written") {
+            runCatching {
+                val metadata = JSONObject(metadataFile.readText())
+                metadata.optBoolean("capturePaused") && metadata.optInt("sampleCount") == 2
+            }.getOrDefault(false)
+        }
+        val restored = newRecorder()
+        await("session restoration did not complete") { !restored.isRestoring }
+
+        assertEquals(sessionId, restored.activeSessionId)
+        assertFalse(restored.isRecording)
+        assertEquals(2, restored.sampleCount)
+        assertNotNull(restored.latestSample)
+        assertEquals("missing", restored.latestSample!!.locationStatus)
+        assertNull(restored.latestSample!!.lat)
+        assertNull(restored.latestSample!!.elapsedRealtimeNanos)
+        assertNotNull(restored.latestSample!!.capturedElapsedRealtimeNanos)
+
+        val root = export(restored)
+        assertEquals(sessionId, root.getString("sessionId"))
+        val samples = root.getJSONArray("samples")
+        assertEquals(2, samples.length())
+        for (index in 0 until samples.length()) {
+            assertTrue(samples.getJSONObject(index).isNull("lat"))
+            assertEquals("missing", samples.getJSONObject(index).getString("locationStatus"))
+        }
+        assertFalse(metadataFile.exists())
+    }
+
+    @Test
+    fun lateServiceStopFromPreviousSessionDoesNotPauseNewSession() {
+        val recorder = startRecorder()
+        val oldSessionId = requireNotNull(recorder.activeSessionId)
+        export(recorder)
+        ShadowSystemClock.advanceBy(Duration.ofSeconds(1))
+        assertTrue(recorder.startSession())
+        assertTrue(oldSessionId != recorder.activeSessionId)
+
+        recorder.onCaptureServiceStopped("previous service instance destroyed", oldSessionId)
+
+        assertTrue(recorder.statusText, recorder.isRecording)
+        captureTick(recorder)
+        assertEquals(1, export(recorder).getJSONArray("samples").length())
+    }
+
+    private fun startRecorder(): GroundTruthViewModel = newRecorder().apply {
+        campaignIdInput = "indoor_test"
+        scenarioIdInput = "known_floor"
+        assertTrue("recorder should start", startSession())
+    }
+
+    private fun newRecorder(): GroundTruthViewModel {
+        val owner = object : ViewModelStoreOwner {
+            override val viewModelStore = ViewModelStore()
+        }
+        stores.add(owner.viewModelStore)
+        // A static getInstance() factory would retain an Application from an earlier Robolectric case.
+        return ViewModelProvider(owner, ViewModelProvider.AndroidViewModelFactory(application))[
+            GroundTruthViewModel::class.java
+        ]
+    }
+
+    private fun captureTick(recorder: GroundTruthViewModel) {
+        val expected = recorder.sampleCount + 1
+        recorder.captureSample()
+        await("recording tick did not append a sample: ${recorder.statusText}") {
+            recorder.sampleCount == expected || recorder.radioSamplingError != null
+        }
+        assertNull("telemetry failed: ${recorder.statusText}", recorder.radioSamplingError)
+        assertEquals(expected, recorder.sampleCount)
+    }
+
+    private fun export(recorder: GroundTruthViewModel): JSONObject {
+        var completed: Result<File>? = null
+        recorder.stopSessionAndExport { completed = it }
+        await("session export did not complete") { completed != null }
+        return JSONObject(requireNotNull(completed).getOrThrow().readText())
+    }
+
+    private fun await(message: String, condition: () -> Boolean) {
+        repeat(500) {
+            shadowOf(Looper.getMainLooper()).idle()
+            if (condition()) return
+            // The telemetry and journal executors are real background threads.
+            Thread.sleep(10L)
+        }
+        val metadata = File(application.filesDir, ACTIVE_SESSION_STATE_FILE)
+        fail("$message; metadata=${runCatching { metadata.readText() }.getOrElse { it.toString() }}")
+    }
+}
