+package com.example.locationdata
+
+import org.json.JSONArray
+
+internal const val MAX_SAVED_INDOOR_LABELS = 80
+
+internal fun IndoorLabel.normalized() = IndoorLabel(
+    building.trim().take(80), floor.trim().take(80), point.trim().take(80), route.trim().take(80)
+)
+
+internal fun loadIndoorLabelChoices(serialized: String?, legacy: IndoorLabel): List<IndoorLabel> {
+    val saved = runCatching {
+        val array = JSONArray(serialized ?: "[]")
+        (0 until minOf(array.length(), MAX_SAVED_INDOOR_LABELS)).mapNotNull { index ->
+            array.optJSONObject(index)?.toIndoorLabel()?.normalized()
+        }
+    }.getOrDefault(emptyList())
+    val previous = legacy.normalized()
+    return (saved + previous).filter { it != IndoorLabel() }.distinct().take(MAX_SAVED_INDOOR_LABELS)
+}
+
+internal fun nextIndoorCode(prefix: String, used: List<String>, atLeast: Long = 1): String {
+    val occupied = used.map { it.trim().uppercase() }.toSet()
+    var next = atLeast.coerceAtLeast(1L)
+    while (prefix.uppercase() + next.toString().padStart(2, '0') in occupied) {
+        check(next < Long.MAX_VALUE) { "No automatic label numbers remain" }
+        next++
+    }
+    check(next < Long.MAX_VALUE) { "No automatic label numbers remain" }
+    return prefix + next.toString().padStart(2, '0')
+}
